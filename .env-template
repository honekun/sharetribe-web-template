# Environment variables for Archivo Vintach (Sharetribe Web Template fork).
#
# IMPORTANT: Variables prefixed with "REACT_APP_" are bundled into the client-side
# JavaScript and exposed to the public web. NEVER put secrets in REACT_APP_ vars.
# https://create-react-app.dev/docs/adding-custom-environment-variables
#
# Copy this file to .env.development for local dev, and set values in
# Heroku/Render config vars for deployed environments.

# ─────────────────────────────────────────────────────────────────────────────
# SHARETRIBE MARKETPLACE API (required)
# ─────────────────────────────────────────────────────────────────────────────
# The Marketplace API handles all user-facing operations: auth, listings, search,
# transactions, etc. It authenticates as a specific user via session tokens.
#
# Get these at: Console → Build → Applications → Add new
#
# CLIENT_ID is public (used in the browser). The CLIENT_SECRET is server-only
# and only needed if your transaction process uses privileged transitions.
# Console also generates a client secret alongside the ID — you can ignore it
# if you don't use privileged transitions.
REACT_APP_SHARETRIBE_SDK_CLIENT_ID=change-me
SHARETRIBE_SDK_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# SHARETRIBE INTEGRATION API (required for AV-noti + bulk import)
# ─────────────────────────────────────────────────────────────────────────────
# The Integration API authenticates as the marketplace operator (not a user).
# It has elevated access: read all events, create listings on behalf of users,
# query across all transactions. Runs server-side only.
#
# Get these at: Console → Build → Integrations → Create integration
#
# Used by:
#   - Event poller / notifications (server/services/eventPoller.js)
#   - Bulk CSV importer (/admin/bulk-import)
#
# Bulk import requires these values independently. Notifications are controlled
# explicitly by the AV_NOTIFICATIONS_ENABLED feature flag below.
SHARETRIBE_INTEGRATION_CLIENT_ID=
SHARETRIBE_INTEGRATION_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# STRIPE (required for payments)
# ─────────────────────────────────────────────────────────────────────────────
# Publishable key only — the secret key is set in Sharetribe Console, not here.
# Use pk_test_ keys for dev/staging, pk_live_ for production.
# Console → Build → Payments → Stripe
REACT_APP_STRIPE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# MAPS
# ─────────────────────────────────────────────────────────────────────────────
REACT_APP_MAPBOX_ACCESS_TOKEN=
# Or use Google Maps instead (uncomment):
# REACT_APP_GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# MARKETPLACE CONFIG
# ─────────────────────────────────────────────────────────────────────────────
# Host/domain — no trailing slash
REACT_APP_MARKETPLACE_ROOT_URL=http://localhost:3000

# Marketplace name (defaults to 'Biketribe' if not set)
REACT_APP_MARKETPLACE_NAME=ArchivoVintach

# Environment: overridden by .env.development and .env.test locally.
# Set to 'production' in deployed environments.
REACT_APP_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# SOCIAL LOGINS / SSO (optional)
# ─────────────────────────────────────────────────────────────────────────────
# If the app/client ID is not set, the auth option is hidden in the UI.
REACT_APP_FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

REACT_APP_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# BREVO (newsletter + transactional email)
# ─────────────────────────────────────────────────────────────────────────────
# Brevo credentials are server-only. The client-side newsletter form posts to
# /api/brevo/subscribe and must never receive API keys or list IDs.
# Welcome email delivery is enabled separately by the notification flags below.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Optional: mirror the first-party consent evidence into matching Brevo contact
# attributes after those attributes have been created in Brevo.
BREVO_CONSENT_ATTRIBUTES_ENABLED=false

# Hosted Spanish transactional-template IDs. Every ID below is required when
# its corresponding notification feature is enabled.
BREVO_TEMPLATE_SELLER_WELCOME=
BREVO_TEMPLATE_VIEWED_LISTING_A=
BREVO_TEMPLATE_VIEWED_LISTING_B=
BREVO_TEMPLATE_ABANDONED_CHECKOUT=
BREVO_TEMPLATE_MATCHING_LISTINGS_A=
BREVO_TEMPLATE_MATCHING_LISTINGS_B=
BREVO_TEMPLATE_SIGNUP_NO_LISTING=
BREVO_TEMPLATE_LISTING_NO_ACTIVITY=

# Configure the Brevo transactional webhook at:
# /api/brevo/webhook?secret=THE_SAME_RANDOM_VALUE
BREVO_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# WHATSAPP NOTIFICATIONS (optional, requires AV-noti + Integration API)
# ─────────────────────────────────────────────────────────────────────────────
# Meta Cloud API credentials for sending WhatsApp notifications.
# Get these from Meta Business Manager → WhatsApp → API Setup.
# Templates must be pre-approved in Meta before use.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=

# Notification delivery is intentionally disabled unless this flag is explicitly
# true. When enabled, each channel must also be explicitly true or false.
AV_NOTIFICATIONS_ENABLED=false
# Automatic post-payment eShip label purchases. This starts the shared event
# poller even when notification delivery above is disabled. Requires Integration
# API credentials, DATABASE_URL, ESHIP_API_KEY, and ESHIP_BASE_URL.
AV_SHIPPING_LABELS_ENABLED=false
AV_WELCOME_EMAIL_NOTIFICATIONS_ENABLED=false
AV_BREVO_CAMPAIGNS_ENABLED=false
AV_WHATSAPP_NOTIFICATIONS_ENABLED=false

# Required when the notification event poller is enabled. Locally, run
# `yarn db:setup` to start PostgreSQL in Docker, then copy this value into
# .env.development. Deployments must use one shared, durable managed database.
DATABASE_URL=postgresql://archivo_vintach:archivo_vintach_dev@localhost:5432/archivo_vintach
# Optional pool size. Minimum 2: one connection is held by the leader lock.
# AV_DATABASE_POOL_MAX=5
# Maximum 100-event pages drained in one poll, and pacing between full pages.
# AV_EVENT_POLLER_MAX_PAGES_PER_POLL=10
# AV_EVENT_POLLER_PAGE_DELAY_MS=250
# Alert when the oldest event observed in a poll is at least this old.
# AV_EVENT_POLLER_LAG_ALERT_MS=900000
# A processing claim must be this old before an operator can explicitly retry it.
# AV_NOTIFICATION_STALE_CLAIM_MINUTES=15
# A label purchase interrupted this long ago becomes "unknown". It still cannot
# be retried until an allowlisted operator confirms carrier reconciliation.
# AV_SHIPPING_LABEL_STALE_CLAIM_MINUTES=15

# ─────────────────────────────────────────────────────────────────────────────
# LIVE SHIPPING QUOTES (eShip / myeship.co — account "Segmail")
# ─────────────────────────────────────────────────────────────────────────────
# Carrier API key (Bearer) used server-side to quote shipping at checkout.
# Required for live quotes; without it, shipping purchases fall back to Contactar AV.
# Reading the seller's origin address also needs the Integration API creds above.
ESHIP_API_KEY=
# Required: carrier base URL (no hardcoded default). Production:
# https://api.myeship.co/rest — QA/test: https://apiqa.myeship.co/rest.
ESHIP_BASE_URL=
# Optional: buyer-price markup over the raw carrier cost (default 0.18 = 18%).
# ESHIP_MARKUP_PCT=
# Optional: when 'true', the quote endpoint echoes the carrier's error text in the
# response (code ESHIP_ERROR + detail). Leave unset/false in production.
# ESHIP_API_DEBUG=false
# Optional: comma-separated emails allowed to retry ANY seller's shipping label
# via POST /api/shipping/label (support staff). Sellers can always retry their own.
# SHIPPING_LABEL_OPERATOR_EMAILS=

# ─────────────────────────────────────────────────────────────────────────────
# INSTAGRAM FEED (optional, requires av-insta-feed block ID + Integration API)
# ─────────────────────────────────────────────────────────────────────────────
# Meta Cloud API credentials for sending WhatsApp notifications.
INSTAGRAM_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# PROVIDER COMMISSION / EARNINGS ESTIMATOR
# ─────────────────────────────────────────────────────────────────────────────
# Percentage and fixed fee come from Console (transactions/commission.json)
# at runtime via mergeConfig. These are fallbacks if the hosted asset is
# unavailable, and are used by the EarningsEstimator display in the listing form.
# REACT_APP_PROVIDER_COMMISSION_PERCENTAGE=10
# REACT_APP_STRIPE_FEE_PERCENTAGE=2.9
# REACT_APP_STRIPE_FEE_FIXED_AMOUNT=30
REACT_APP_PROVIDER_COMMISSION_FIXED_FEE=1500

# ─────────────────────────────────────────────────────────────────────────────
# BULK IMPORT (optional, requires Integration API)
# ─────────────────────────────────────────────────────────────────────────────
# CSV + image importer at /admin/bulk-import.
# Any signed-in user can bulk-import listings for themselves.
# BULK_IMPORT_OPERATOR_EMAILS (comma-separated) flags "admin" users who may add a
# `user_id` column to the CSV to create listings on behalf of other users.
BULK_IMPORT_OPERATOR_EMAILS=
BULK_IMPORT_LISTING_TYPE=av-listing
BULK_IMPORT_TRANSACTION_ALIAS=default-purchase/release-1
BULK_IMPORT_UNIT_TYPE=item

# ─────────────────────────────────────────────────────────────────────────────
# CSP / SECURITY
# ─────────────────────────────────────────────────────────────────────────────
# Content Security Policy: 'report' (log violations) or 'block' (enforce).
# If missing, CSP is disabled.
REACT_APP_CSP=report

# REACT_APP_SHARETRIBE_USING_SSL=true
# SERVER_SHARETRIBE_TRUST_PROXY=true
# BASIC_AUTH_USERNAME=sharetribe
# BASIC_AUTH_PASSWORD=secret

# ─────────────────────────────────────────────────────────────────────────────
# ANALYTICS (optional)
# ─────────────────────────────────────────────────────────────────────────────
# GA4 ID (starts with 'G-'). Turn off "Enhanced measurements" in GA.
# REACT_APP_GOOGLE_ANALYTICS_ID=change-me

# Plausible: comma-separated domains. Requires a plausible.io account.
# REACT_APP_PLAUSIBLE_DOMAINS=my.marketplace.com

# ─────────────────────────────────────────────────────────────────────────────
# MONITORING (optional)
# ─────────────────────────────────────────────────────────────────────────────
# REACT_APP_SENTRY_DSN=change-me

# ─────────────────────────────────────────────────────────────────────────────
# CACHING / DEBUG (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Cache TTL for proxied SDK asset calls. 0 = no caching.
# TTL=60
# TTL_ASSETS_BY_VERSION=86400

# VERBOSE=true
# PREVENT_DATA_LOADING_IN_SSR=true
